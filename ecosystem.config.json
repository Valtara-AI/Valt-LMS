{
  "name": "valt-lms",
  "script": "npm",
  "args": "start",
  "instances": 1,
  "exec_mode": "cluster",
  "watch": false,
  "max_memory_restart": "500M",
  "env": {
    "NODE_ENV": "production",
    "PORT": 3000
  },
  "error_file": "/var/log/pm2/valt-lms-error.log",
  "out_file": "/var/log/pm2/valt-lms-out.log",
  "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
  "merge_logs": true,
  "autorestart": true,
  "max_restarts": 10,
  "min_uptime": "10s"
}
